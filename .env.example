# Load into the launching process environment; this file is not auto-loaded.
TIGERGRAPH_BASE_URL=https://your-cluster.i.tgcloud.io
TIGERGRAPH_GRAPH=HHGOA_Fraud
TIGERGRAPH_TIMEOUT=60

# Prefer an existing token. Never put credentials in this example file.
TIGERGRAPH_TOKEN=

# Alternatively, pyTigerGraph can use a secret or username/password.
# Token takes precedence when set. The application does not save credentials.
TIGERGRAPH_SECRET=
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
